  <qresource prefix="/Controls">
    <file alias="Joystick.qml">qml/Controls/Joystick.qml</file>
    <file alias="JoystickForm.ui.qml">qml/Controls/JoystickForm.ui.qml</file>
  </qresource>
	<qresource prefix="/Dialogs">
