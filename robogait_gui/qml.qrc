	  <file alias="MapDetailsDialog.qml">qml/Dialogs/MapDetailsDialog.qml</file>
    <file alias="MapRegisterDialog.qml">qml/Dialogs/MapRegisterDialog.qml</file>
	  <file alias="PatientDetailsDialog.qml">qml/Dialogs/PatientDetailsDialog.qml</file>
	  <file alias="PatientRegisterDialog.qml">qml/Dialogs/PatientRegisterDialog.qml</file>
	  <file alias="RosDomainIdTab.qml">qml/Dialogs/RosDomainIdTab.qml</file>
