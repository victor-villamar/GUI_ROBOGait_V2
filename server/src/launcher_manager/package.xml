<?xml version="1.0"?>
<package format="3">
  <name>launcher_manager</name>
  <version>0.1.0</version>
  <description>Manages the launch of the necessary nodes on the server for the robogait GUI</description>

  <maintainer email="victorjosevillamar@gmail.com">Victor Jose Villamar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <depend>rclcpp</depend>
  <depend>logs</depend>
  <depend>yaml-cpp</depend>
  <depend>boost</depend>
  <depend>interface_srv</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
