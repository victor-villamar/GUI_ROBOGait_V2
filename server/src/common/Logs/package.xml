<?xml version="1.0"?>
<package format="3">
  <name>logs</name>
  <version>0.0.1</version>
  <description>Unified logging library for ROBOGait with ROS 2 integration</description>
  <maintainer email="victorjosevillamar@gmail.com"> Victor Villamar</maintainer>
  <license>Apache-2.0</license>

  <!-- Compilation and execution dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>

  <!-- Optional: test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>